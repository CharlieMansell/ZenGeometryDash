{
  "name": "zens-games",
  "productName": "Zen's Games",
  "version": "1.0.0",
  "description": "Zen's arcade \u2014 a collection of games built by Zen & Dad",
  "author": "Charlie Mansell",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^42.4.0",
    "electron-builder": "^26.15.2"
  },
  "build": {
    "appId": "com.charliemansell.zensgames",
    "productName": "Zen's Games",
    "files": [
      "electron/**",
      "web/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "ZensGames-Setup.exe",
      "deleteAppDataOnUninstall": true
    },
    "portable": {
      "artifactName": "ZensGames-Portable.exe"
    }
  }
}